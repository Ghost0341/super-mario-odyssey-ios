// Execute the current frontend methods with synthetic scene/window/layer peers.
// This tests adapter behavior, not UIKit delivery, Metal or game execution.
#import <Foundation/Foundation.h>
#import <CoreGraphics/CoreGraphics.h>
#import <dispatch/dispatch.h>
#include <assert.h>
#include "dm_display_geometry.h"
#define DM_GAME_DISPLAY_ASPECT (4.0/3.0)
static int auditLiveDisplay;
static double auditRequestedAspect;
static int dm_odyssey_display_geometry(double width,double height,double top,double left,double bottom,double right) {
    (void)top;(void)left;(void)bottom;(void)right;
    if (!isfinite(width) || !isfinite(height) || width<=0 || height<=0 || width>16384 || height>16384) return 0;
    double aspect=width/height;
    auditRequestedAspect=aspect>=1 && aspect<=16.0/9 ? aspect : 0;
    return auditRequestedAspect>0;
}
static double dm_odyssey_display_scene_aspect(void) {
    return auditLiveDisplay && auditRequestedAspect>0 ? auditRequestedAspect : DM_GAME_DISPLAY_ASPECT;
}
typedef struct { CGFloat top,left,bottom,right; } UIEdgeInsets;
@interface CATransaction : NSObject
+ (void)begin;
+ (void)setDisableActions:(BOOL)disabled;
+ (void)commit;
@end
@implementation CATransaction
+ (void)begin {}
+ (void)setDisableActions:(BOOL)disabled { (void)disabled; }
+ (void)commit {}
@end
